{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/api/v1/ping",
    "headers": {"Authorization": {"equalTo": "Bearer legacy-demo-token"}}
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json", "Cache-Control": "no-store"},
    "jsonBody": {
      "service": "legacy-demo",
      "authenticated": true,
      "credentialType": "LEGACY_SERVICE_TOKEN",
      "proof": "legacy bearer accepted"
    }
  }
}
