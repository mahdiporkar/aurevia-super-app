{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "headers": {"Content-Type": {"contains": "application/x-www-form-urlencoded"}},
    "bodyPatterns": [
      {"contains": "username=legacy-demo"},
      {"contains": "password=local-demo-only"}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json", "Cache-Control": "no-store"},
    "jsonBody": {
      "access_token": "legacy-demo-token",
      "token_type": "Bearer",
      "expires_in": 300
    }
  }
}
