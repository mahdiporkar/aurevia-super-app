{
  "name": "aurevia-super-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.15.0 <23", "npm": "10.9.2" },
  "workspaces": ["apps/*", "packages/*", "tests/e2e"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace=@aurevia/shell",
    "dev:mfe:admin": "npm run dev --workspace=@aurevia/mfe-admin",
    "dev:mfe:hr": "npm run dev --workspace=@aurevia/mfe-hr",
    "dev:mfe:finance": "npm run dev --workspace=@aurevia/mfe-finance",
    "dev:mfe:reports": "npm run dev --workspace=@aurevia/mfe-reports",
    "clean": "npm run clean --workspaces --if-present",
    "openfga:bootstrap": "node tools/openfga-bootstrap.mjs",
    "infra:preflight": "node tools/infra-preflight.mjs",
    "infra:verify": "node tools/fresh-install-verify.mjs",
    "infra:verify:token-proxy": "node tools/verify-token-proxy.mjs",
    "dev:mf-test-sso": "npm run dev --workspace=@aurevia/mf-test-sso",
    "dev:mf-test-legacy": "npm run dev --workspace=@aurevia/mf-test-legacy",
    "e2e:auth:build": "npm run build --workspace=@aurevia/mf-test-sso && npm run build --workspace=@aurevia/mf-test-legacy",
    "e2e:auth:prepare": "node tools/e2e-auth/prepare.mjs",
    "e2e:auth:core:up": "docker compose --env-file .env -f infra/docker-compose/compose.yml -f infra/docker-compose/compose.e2e-auth-core.yml up -d --no-build",
    "e2e:auth:up": "docker compose --env-file .tmp/e2e-auth/demo.env -f infra/docker-compose/compose.e2e-auth.yml up -d --build",
    "e2e:auth:down": "docker compose --env-file .tmp/e2e-auth/demo.env -f infra/docker-compose/compose.e2e-auth.yml down",
    "e2e:auth:verify": "node tools/e2e-auth/verify.mjs",
    "e2e:auth:report": "node tools/e2e-auth/report.mjs",
    "infra:config:test": "node tools/verify-core-compose-isolation.mjs",
    "release:verify:runtime": "node tools/release-runtime-verify.mjs",
    "infra:up": "npm run infra:preflight && docker compose --env-file .env -f infra/docker-compose/compose.yml up -d --build --remove-orphans",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose/compose.yml down --remove-orphans",
    "identity:up": "docker compose --env-file .env -f infra/docker-compose/compose.identity-demo.yml up -d",
    "identity:down": "docker compose --env-file .env -f infra/docker-compose/compose.identity-demo.yml down",
    "superset:up": "docker compose --env-file .env -f infra/docker-compose/compose.superset-demo.yml up -d --build",
    "superset:down": "docker compose --env-file .env -f infra/docker-compose/compose.superset-demo.yml down",
    "superset:config:test": "node tools/verify-superset-compose-isolation.mjs",
    "mfe:preflight": "node tools/mfe-demo-preflight.mjs",
    "mfe:build": "npm run build --workspace=@aurevia/mfe-admin && npm run build --workspace=@aurevia/mfe-hr && npm run build --workspace=@aurevia/mfe-finance && npm run build --workspace=@aurevia/mfe-reports",
    "mfe:up": "npm run mfe:preflight && docker compose -f infra/docker-compose/compose.mfe-demo.yml up -d",
    "mfe:down": "docker compose -f infra/docker-compose/compose.mfe-demo.yml down"
  },
  "devDependencies": {
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.4",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.2",
    "webpack": "5.110.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "6.0.0"
  }
}
