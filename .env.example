POSTGRES_AUTH_DB=aurevia_auth
POSTGRES_AUTH_USER=aurevia
POSTGRES_AUTH_PASSWORD=change-me
REDIS_PASSWORD=change-me
TOKEN_VAULT_KEY_ID=local-v1
TOKEN_VAULT_KEY_BASE64=replace-with-32-byte-base64-key
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_CLIENT_ID=aurevia-bff
OIDC_CLIENT_SECRET=change-me
# Identity Provider client secrets are resolved by the BFF from secret:// references.
# Local Compose injects only the demo reference; production mounts IDENTITY_PROVIDER_SECRET_ROOT.
IDENTITY_PROVIDER_SECRET_ROOT=/run/secrets/aurevia/identity
OPENFGA_STORE_ID=created-by-bootstrap
OPENFGA_MODEL_ID=created-by-model-deployment
# Authorization Service defaults to false; local Compose deliberately overrides it to true.
OPENFGA_RECONCILE_ON_STARTUP=false
# Development only: also requires the authorization-service Spring profile "dev".
RESOURCE_TREE_DEVELOPMENT_MUTATIONS_ENABLED=false
# Values below belong only to compose.superset-demo.yml; Aurevia Core does not consume them.
OPERATION_SUPERSET_SECRET_KEY=change-me-separate-operation-key
OPERATION_SUPERSET_DB_PASSWORD=change-me
OPERATION_SUPERSET_ADMIN_PASSWORD=local-change-me
SUPERSET_LOAD_EXAMPLES=yes
# Comma-separated native Superset dashboard IDs whose datasource read access is
# required by the registered Aurevia report assets in the local demo.
SUPERSET_AUREVIA_DASHBOARD_IDS=7
# Local demo only. Keep Gamma or map application roles explicitly in production.
SUPERSET_REMOTE_USER_ROLE=Gamma
# Local demo identities that should see Superset's native dashboard-edit controls.
SUPERSET_REMOTE_EDIT_USERS=administrator,report-designer
# Local directory-test values only; override them outside source control for shared environments.
DIRECTORY_SYNC_ENABLED=false
DIRECTORY_LDAP_URL=ldap://host.docker.internal:1389
DIRECTORY_BASE_DN=DC=aurevia,DC=test
DIRECTORY_BIND_DN=CN=Administrator,CN=Users,DC=aurevia,DC=test
DIRECTORY_BIND_PASSWORD=local-directory-only
DIRECTORY_ISSUER=http://localhost:8180/realms/aurevia
SAMBA_ADMIN_PASSWORD=local-directory-only
SAMBA_TEST_USER_PASSWORD=local-user-only
# MFE URLs are registry data, never environment entries. These five variables are read by BOTH
# the Authorization Service (registration) and the BFF (runtime fetch) so the two always agree.
# Modes: DEVELOPMENT (default in Compose; loopback rewritten to UI_ARTIFACT_DEVELOPMENT_HOST),
# INTERNAL_ENTERPRISE (private ranges only from UI_ARTIFACT_ALLOWED_PRIVATE_CIDRS),
# PRODUCTION_INTERNET (public addresses only), UNRESTRICTED (no address-class restriction for
# administrator-managed MFEs: loopback, LAN, private, public, IPv4/IPv6, any DNS. Only
# cloud-metadata, link-local, multicast, unspecified and reserved addresses stay blocked).
# UI_ARTIFACT_NETWORK_POLICY=UNRESTRICTED
# UI_ARTIFACT_DEVELOPMENT_HOST=host.docker.internal
# UI_ARTIFACT_ALLOW_HTTP=true
# UI_ARTIFACT_ALLOWED_PRIVATE_CIDRS=10.0.0.0/8,192.168.0.0/16
# UI_ARTIFACT_REQUIRE_INTEGRITY=false
# Comma-separated hostnames accepted when an administrator registers Service Targets.
# OPERATION_GATEWAY_APPROVED_HOSTS=operation-gateway,external-gateway.company.test
# Exact extra origins the BFF may call (the primary OPERATION_GATEWAY_URL is always included).
# OPERATION_GATEWAY_APPROVED_BASE_URLS=https://external-gateway.company.test
