# =====================================================================
# PRIMARY AUTHENTICATION - KEYCLOAK / OIDC
#
# Keycloak:
# https://192.168.1.1:8444
#
# Realm:
# aurevia
#
# Client:
# aurevia-java
# =====================================================================

OIDC_ISSUER_URI=https://172.24.66.73:8444/realms/aurevia

OIDC_CLIENT_ID=aurevia-java
OIDC_CLIENT_SECRET=kMcPB1Y5s0aHME8ecwxv7X2j5ytXGgdr

OIDC_SCOPES=openid,profile,email

# Keycloak discovery is used.
# Do not manually override authorization/token/JWKS/userinfo endpoints.
OIDC_ENDPOINT_OVERRIDES_ENABLED=false


# =====================================================================
# KEYCLOAK ADMIN REST API
#
# Dedicated confidential service-account client.
# Recommended permissions:
# realm-management/manage-users
# =====================================================================

KEYCLOAK_ADMIN_CLIENT_ID=aurevia-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=<AUREVIA_IDENTITY_ADMIN_CLIENT_SECRET>

KEYCLOAK_ADMIN_BASE_URL=https://192.168.1.1:8444


# =====================================================================
# FIRST SYSTEM ADMINISTRATOR
#
# Use the real Keycloak User ID / sub from realm "aurevia".
#
# IMPORTANT:
# If your renamed source code uses:
# AUREVIA_BOOTSTRAP_ADMIN_SUB
#
# use that variable instead of:
# AUREVIA_BOOTSTRAP_ADMIN_SUB
# =====================================================================

AUREVIA_BOOTSTRAP_ADMIN_SUB=06ab29da-6fb5-4497-b5ba-b991dff28d1e


# =====================================================================
# SECONDARY IDENTITY PROVIDERS
# =====================================================================

